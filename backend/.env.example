# AiTaskApi Backend Configuration
# Copy this file to .env and fill in your values

# Database connection string (PostgreSQL)
ConnectionStrings__Default="Host=localhost;Port=5432;Database=aitaskapi;Username=postgres;Password=your_password_here"

# JWT signing key (generate a strong random string, minimum 32 characters)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"

# AI / Ollama Configuration (optional - leave empty to disable AI features)
LLM_SERVER="http://localhost:11434"
OLLAMA_MODEL="gemma4:e4b"

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT="Development"
